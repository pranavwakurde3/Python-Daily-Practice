   "source": [
    "**Print 1 to n using Recursion**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "2afc487e-1cd4-4bf3-a9e6-b872608541dc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1 2 3 4 5 "
     ]
    }
   ],
   "source": [
    "def printno(i,n):\n",
    "    if i>n:\n",
    "        return\n",
    "    print(i,end=\" \")\n",
    "    printno(i+1,n)\n",
    "printno(1,5)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e0167552-124a-4e1b-b16b-2a4791c701de",
   "metadata": {},
   "source": [
    "**No of factorial**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "6167ce5e-3a36-45f4-a4ab-f90bd879551f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "24\n"
     ]
    }
   ],
   "source": [
    "def fact(n):\n",
    "    if n==0:\n",
    "        return 1\n",
    "    return n*fact(n-1)\n",
    "print(fact(4))"
   ]
  },
