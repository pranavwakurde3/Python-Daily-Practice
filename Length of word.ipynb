   "source": [
    "class Solution:\n",
    "    def lengthOfLastWord(self, s: str) -> int:\n",
    "        s=s.strip()\n",
    "        n=len(s)\n",
    "\n",
    "        i= -1\n",
    "        while i>=(-1*n) and s[i]!=\" \":\n",
    "            i-=1\n",
    "\n",
    "        i+=1\n",
    "        i*=-1\n",
    "\n",
    "        return i"
   ]
  },
