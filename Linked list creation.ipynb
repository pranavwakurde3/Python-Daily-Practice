   "source": [
    "class Node:\n",
    "    def __init__(self,data):\n",
    "        self.data = data\n",
    "        self.next = None\n",
    "\n",
    "a = Node(5)\n",
    "b = Node(3)\n",
    "c = Node(7)\n",
    "\n",
    "a.next = b\n",
    "b.next = c\n",
    "\n",
    "head = a\n",
    "\n",
    "print(head.data)\n",
    "print(head.next.data)\n",
    "print(head.next.next.data)"
   ]
  },
